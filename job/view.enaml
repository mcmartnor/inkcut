import os
from datetime import datetime
from enaml.image import Image
from enaml.widgets.api import (
    Container, Label, ImageView, SpinBox, CheckBox, PushButton, RadioButton,
    Form, ObjectCombo, Menu, Action, GroupBox
)
from enaml.core.api import Looper, Conditional
from enaml.layout.api import hbox, vbox, spacer, align
from enaml.qt.QtWidgets import QApplication
from enamlx.widgets.api import (
    DoubleSpinBox, TableView, TableViewRow, TableViewItem
)

from inkcut.core.api import DockItem, Section
from inkcut.ui.widgets import PanelScroll, SectionHeader
from inkcut.core.utils import (
    load_icon, load_image, from_unit, to_unit, color_icon
)
from inkcut.job.plugin import Job


def selected_item(items, uid):
    return next((item for item in items if item.uid == uid), None) if uid else None


def problem_uids(problems):
    return {uid for uid, _ in problems}


def is_echo(view, value, model_value):
    """A value equal to the displayed model value (exact or as the spin box
    rounds it) comes from a binding, not from the user."""
    return value == model_value or value == round(model_value, view.decimals)


def resync(view, getter, current=lambda: True):
    """Show the model value again once the signal handling is done.

    `current` tells whether `getter` still describes what the view shows
    (the job or the selected item may have changed meanwhile). The widget is
    refreshed explicitly: the Qt proxy drops value updates made while its own
    valueChanged is being handled, so view.value may already be right while
    the widget still shows the typed value.
    """
    from enaml.application import deferred_call, Application

    def sync():
        if current():
            view.value = getter()
        if view.proxy_is_active:
            view.proxy.set_value(view.value)

    if Application.instance() is None:
        sync()
    else:
        deferred_call(sync)


def edit_item_size(plugin, job, item, axis, view, change):
    """Width (axis 0) / height (axis 1) of one copy of the selected item."""
    if item is None or item.size[axis] <= 0:
        return
    shown = lambda: to_unit(item.size[axis], plugin.units)
    current = lambda: plugin.job is job and job.selected_uid == item.uid
    value = change['value']
    if is_echo(view, value, shown()):
        return
    old = list(item.scale)
    try:
        if value <= 0:
            raise ValueError("The size must be larger than 0")
        k = from_unit(value, plugin.units) / item.size[axis]
        if item.lock_scale:
            scale = [old[0] * k, old[1] * k]
        else:
            #: The visible width follows scale[1] when the file is turned 90°
            control = axis if item.rotation % 180 == 0 else 1 - axis
            scale = list(old)
            scale[control] = old[control] * k
        item.scale = scale
        if list(item.scale) != scale:
            raise ValueError("Invalid size")
    except Exception as e:
        plugin.workbench.message_critical(title="Invalid size", message=str(e))
        if list(item.scale) != old:
            item.scale = old
    resync(view, shown, current)


def edit_item_padding(plugin, job, item, index, view, change):
    if item is None or len(item.weedline_padding) != 4:
        return
    shown = lambda: to_unit(job.item_padding(item)[index], plugin.units)
    current = lambda: plugin.job is job and job.selected_uid == item.uid
    value = change['value']
    if is_echo(view, value, shown()):
        return
    padding = list(item.weedline_padding)
    padding[index] = from_unit(value, plugin.units)
    item.weedline_padding = padding
    if list(item.weedline_padding) != padding:
        resync(view, shown, current)


def edit_layout_size(plugin, job, axis, view, change):
    shown = lambda: to_unit(job.layout_size[axis], plugin.units)
    current = lambda: plugin.job is job
    value = change['value']
    if is_echo(view, value, shown()):
        return
    try:
        target = from_unit(value, plugin.units)
        if axis == 0:
            job.scale_layout(target_w=target)
        else:
            job.scale_layout(target_h=target)
    except ValueError as e:
        plugin.workbench.message_critical(title="Invalid size", message=str(e))
    resync(view, shown, current)


def try_update_setting(plugin, view, field, index, change, title="Does not fit"):
    """ Try to update the field with the given index and change. If it fails with a JobError,
    revert

    """
    try:
        field[index] = from_unit(change['value'], plugin.units)
    except Exception as e:
        plugin.workbench.message_critical(title=title, message=str(e))
        field[index] = from_unit(change['oldvalue'], plugin.units)
        view.value = change['oldvalue']


enamldef GraphicDockItem(DockItem):
    attr plugin
    attr job: Job << plugin.job
    icon = load_icon('vector')
    name = 'graphic-item'
    title = QApplication.translate("job", "Graphic")
    Container:
        padding = 0
        PanelScroll:
            Container:
                Section:
                    #: Multi-file layout: total size, file list and the selected file
                    visible << bool(job.items)
                    padding = 0
                    SectionHeader: h_layout:
                        name = 'section-layout-size'
                        title = QApplication.translate("job", "Layout width / height")
                    Section:
                        visible << h_layout.expanded
                        padding = 0
                        Form:
                            padding = 0
                            ImageView:
                                image = load_image('text_letterspacing')
                            DoubleSpinBox: layout_w:
                                value << to_unit(job.layout_size[0], plugin.units)
                                value :: edit_layout_size(plugin, job, 0, self, change)
                                enabled << job.layout_size[0] > 0
                                suffix << " "+plugin.units
                                minimum = 0
                                maximum = 99999.9
                            ImageView:
                                image = load_image('text_linespacing')
                            DoubleSpinBox: layout_h:
                                value << to_unit(job.layout_size[1], plugin.units)
                                value :: edit_layout_size(plugin, job, 1, self, change)
                                enabled << job.layout_size[1] > 0
                                suffix << " "+plugin.units
                                minimum = 0
                                maximum = 99999.9
                    SectionHeader: h_files:
                        name = 'section-files'
                        title = QApplication.translate("job", "Files")
                    Section:
                        visible << h_files.expanded
                        padding = 0
                        Looper:
                            iterable << list(job.items)
                            Container:
                                padding = 0
                                constraints = [hbox(current, row, marker, spacer),
                                               align('v_center', current, row, marker)]
                                #: Selection marker; not a checkable button, whose checked
                                #: binding a click would overwrite
                                Label: current:
                                    text = "▶"
                                    foreground = '#1976d2'
                                    visible << job.selected_uid == loop_item.uid
                                PushButton: row:
                                    #: A long file name is clipped, it does not widen the panel
                                    hug_width = 'weak'
                                    resist_width = 'ignore'
                                    text << str(loop_item) + (" ×%d" % loop_item.copies if loop_item.copies > 1 else "")
                                    clicked :: job.selected_uid = loop_item.uid
                                Label: marker:
                                    text = "●"
                                    foreground = '#d32f2f'
                                    visible << loop_item.uid in problem_uids(job.layout_problems)
                    Section: item_form:
                        attr sel << selected_item(job.items, job.selected_uid)
                        visible << sel is not None
                        padding = 0
                        SectionHeader: h_file:
                            name = 'section-file'
                            resist_width = 'ignore'
                            title << str(sel) if sel is not None else ""
                        Section:
                            visible << h_file.expanded
                            padding = 0
                            Form:
                                padding = 0
                                Label:
                                    text = QApplication.translate("job", "Width")
                                DoubleSpinBox: item_w:
                                    value << to_unit(sel.size[0], plugin.units) if sel is not None else 0
                                    value :: edit_item_size(plugin, job, sel, 0, self, change)
                                    enabled << sel is not None and sel.size[0] > 0
                                    suffix << " "+plugin.units
                                    minimum = 0
                                    maximum = 99999.9
                                Label:
                                    text = QApplication.translate("job", "Height")
                                DoubleSpinBox: item_h:
                                    value << to_unit(sel.size[1], plugin.units) if sel is not None else 0
                                    value :: edit_item_size(plugin, job, sel, 1, self, change)
                                    enabled << sel is not None and sel.size[1] > 0
                                    suffix << " "+plugin.units
                                    minimum = 0
                                    maximum = 99999.9
                            CheckBox: item_lock:
                                text = QApplication.translate("job", "Lock aspect ratio")
                                checked << sel.lock_scale if sel is not None else True
                                toggled ::
                                    if sel is not None:
                                        sel.lock_scale = change['value']
                            CheckBox: item_frame:
                                text = QApplication.translate("job", "Frame (weedline)")
                                checked << sel.weedline if sel is not None else False
                                toggled ::
                                    if sel is not None and sel.weedline != change['value']:
                                        sel.weedline = change['value']
                            CheckBox: item_own:
                                text = QApplication.translate("job", "Own spacing")
                                checked << len(sel.weedline_padding) == 4 if sel is not None else False
                                toggled ::
                                    if sel is not None:
                                        if change['value'] and len(sel.weedline_padding) != 4:
                                            sel.weedline_padding = job.item_padding(sel)
                                        elif not change['value'] and sel.weedline_padding:
                                            sel.weedline_padding = []
                            Form:
                                padding = 0
                                ImageView:
                                    image = load_image('text_padding_left')
                                DoubleSpinBox:
                                    value << to_unit((sel.weedline_padding if len(sel.weedline_padding) == 4 else job.item_weedline_padding)[0], plugin.units) if sel is not None else 0
                                    value :: edit_item_padding(plugin, job, sel, 0, self, change)
                                    enabled << item_own.checked
                                    suffix << " "+plugin.units
                                    maximum = 99999.9
                                    single_step = 0.1
                                ImageView:
                                    image = load_image('text_padding_top')
                                DoubleSpinBox:
                                    value << to_unit((sel.weedline_padding if len(sel.weedline_padding) == 4 else job.item_weedline_padding)[1], plugin.units) if sel is not None else 0
                                    value :: edit_item_padding(plugin, job, sel, 1, self, change)
                                    enabled << item_own.checked
                                    suffix << " "+plugin.units
                                    maximum = 99999.9
                                    single_step = 0.1
                                ImageView:
                                    image = load_image('text_padding_right')
                                DoubleSpinBox:
                                    value << to_unit((sel.weedline_padding if len(sel.weedline_padding) == 4 else job.item_weedline_padding)[2], plugin.units) if sel is not None else 0
                                    value :: edit_item_padding(plugin, job, sel, 2, self, change)
                                    enabled << item_own.checked
                                    suffix << " "+plugin.units
                                    maximum = 99999.9
                                    single_step = 0.1
                                ImageView:
                                    image = load_image('text_padding_bottom')
                                DoubleSpinBox:
                                    value << to_unit((sel.weedline_padding if len(sel.weedline_padding) == 4 else job.item_weedline_padding)[3], plugin.units) if sel is not None else 0
                                    value :: edit_item_padding(plugin, job, sel, 3, self, change)
                                    enabled << item_own.checked
                                    suffix << " "+plugin.units
                                    maximum = 99999.9
                                    single_step = 0.1
                            Form:
                                padding = 0
                                Label:
                                    text = QApplication.translate("job", "Rotation")
                                ObjectCombo: item_rotation:
                                    items = [0, 90, 180, 270]
                                    to_string = lambda r: "%d °" % r
                                    selected << sel.rotation if sel is not None else 0
                                    selected ::
                                        if sel is not None and change['value'] != sel.rotation:
                                            job.set_item_rotation(sel, change['value'])
                                Label:
                                    text = QApplication.translate("job", "Copies")
                                SpinBox: item_copies:
                                    value << sel.copies if sel is not None else 1
                                    value ::
                                        if sel is not None and change['value'] != sel.copies:
                                            sel.copies = change['value']
                                    minimum = 1
                                    maximum = 99999
                            Container:
                                padding = 0
                                constraints = [hbox(fx, fy, spacer)]
                                PushButton: fx:
                                    checkable = True
                                    text = QApplication.translate("job", "Flip X")
                                    icon = load_icon('shape_flip_horizontal')
                                    checked << sel.mirror[0] if sel is not None else False
                                    toggled ::
                                        if sel is not None and sel.mirror[0] != change['value']:
                                            sel.mirror = [change['value'], sel.mirror[1]]
                                PushButton: fy:
                                    checkable = True
                                    text = QApplication.translate("job", "Flip Y")
                                    icon = load_icon('shape_flip_vertical')
                                    checked << sel.mirror[1] if sel is not None else False
                                    toggled ::
                                        if sel is not None and sel.mirror[1] != change['value']:
                                            sel.mirror = [sel.mirror[0], change['value']]
                Section:
                    visible << not job.items
                    padding = 0
                    SectionHeader: h_size:
                        name = 'section-graphic-size'
                        title = QApplication.translate("job", "Graphic Size")
                    Section:
                        visible << h_size.expanded
                        padding = 0
                        Form:
                            padding = 0
                            ImageView:
                                image = load_image('text_letterspacing')
                            DoubleSpinBox:
                                value << to_unit(job.size[0], plugin.units)
                                value ::
                                    #print("callback",change)
                                    v = to_unit(job.size[0], plugin.units)
                                    changed = v != change['value']
                                    if changed and change['oldvalue']>0 and change['value']>0:
                                        s = job.scale[0] * change['value']/change['oldvalue']
                                        oldvalue = job.scale
                                        try:
                                            if job.lock_scale:
                                                job.scale = [s,s]
                                            else:
                                                job.scale[0] = s
                                        except Exception as e:
                                           plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                           job.scale = oldvalue
                                           self.value = change['oldvalue']
                                suffix << " "+plugin.units
                                minimum = 0.00001
                                maximum = 99999.9
                            ImageView:
                                image = load_image('text_linespacing')
                            DoubleSpinBox:
                                value << to_unit(job.size[1], plugin.units)
                                value ::
                                    #print("callback",change)
                                    v = to_unit(job.size[1], plugin.units)
                                    changed = v != change['value']
                                    if changed and change['oldvalue']>0 and change['value']>0:
                                        s = job.scale[1] * change['value']/change['oldvalue']
                                        oldvalue = job.scale
                                        try:
                                            if job.lock_scale:
                                                job.scale = [s,s]
                                            else:
                                                job.scale[1] = s
                                        except Exception as e:
                                           plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                           job.scale = oldvalue
                                           self.value = change['oldvalue']
                                suffix << " "+plugin.units
                                minimum = 0.00001
                                maximum = 99999.9
                            ImageView:
                                image << load_image(job.lock_scale and 'text_kerning' or 'text_letterspacing')
                            DoubleSpinBox:
                                value << 100*job.scale[0]
                                value ::
                                    s = change['value']/100.0
                                    oldvalue = job.scale
                                    try:
                                        if job.lock_scale:
                                            job.scale = [s,s]
                                        else:
                                            job.scale[0] = s
                                    except Exception as e:
                                       plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                       job.scale = oldvalue
                                       self.value = change['oldvalue']
                                suffix = ' %'
                                minimum = 0.00001
                                maximum = 99999.9
                            ImageView:
                                visible << not job.lock_scale
                                image = load_image('text_linespacing')
                            DoubleSpinBox:
                                visible << not job.lock_scale
                                value << 100*job.scale[1]
                                value ::
                                    s = change['value']/100.0
                                    oldvalue = job.scale
                                    try:
                                        if job.lock_scale:
                                            job.scale = [s,s]
                                        else:
                                            job.scale[1] = s
                                    except Exception as e:
                                       plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                       job.scale = oldvalue
                                       self.value = change['oldvalue']
                                suffix = ' %'
                                minimum = 0.00001
                                maximum = 99999.9
                        CheckBox:
                            text = QApplication.translate("job", "Lock aspect ratio")
                            checked := job.lock_scale
                        Conditional:
                            #: Whole layout (all copies incl. spacing), shown as soon as
                            #: a document has a layout (final_size > 0).
                            #: Editable: typing a total scales the graphic by the
                            #: ratio; spacing is fixed and stacking may reflow, so the
                            #: field re-displays the actual resulting total after the
                            #: layout recomputes.
                            condition << job.final_size[0] > 0 or job.final_size[1] > 0
                            Label:
                                text = QApplication.translate("job", "Total Size")
                            Form:
                                padding = 0
                                ImageView:
                                    image = load_image('text_letterspacing')
                                DoubleSpinBox:
                                    value << to_unit(job.final_size[0], plugin.units)
                                    value ::
                                        #: The Qt spinbox rounds to `decimals`; a
                                        #: programmatic update (e.g. copies changed)
                                        #: comes back rounded, and Qt (half-up) and
                                        #: Python (banker's) can disagree by one ulp
                                        #: at halves — so treat anything within one
                                        #: display quantum as "unchanged" or the
                                        #: handler mistakes the echo for the user
                                        #: typing a new total and scales the job.
                                        v = to_unit(job.final_size[0], plugin.units)
                                        changed = abs(v - change['value']) > 1.01 * 10 ** (-self.decimals)
                                        if changed and change['oldvalue'] > 0 and change['value'] > 0:
                                            k = job.scale[0] * change['value']/change['oldvalue']
                                            #: copy: job.scale[0] = k mutates the
                                            #: same list oldvalue would point at
                                            oldvalue = job.scale[:]
                                            try:
                                                if job.lock_scale:
                                                    job.scale = [k, k]
                                                else:
                                                    job.scale[0] = k
                                            except Exception as e:
                                                plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                                job.scale = oldvalue
                                                self.value = change['oldvalue']
                                    suffix << " "+plugin.units
                                    minimum = 0.00001
                                    maximum = 99999.9
                                ImageView:
                                    image = load_image('text_linespacing')
                                DoubleSpinBox:
                                    value << to_unit(job.final_size[1], plugin.units)
                                    value ::
                                        #: See width field: one display quantum of
                                        #: tolerance to ignore programmatic echoes
                                        v = to_unit(job.final_size[1], plugin.units)
                                        changed = abs(v - change['value']) > 1.01 * 10 ** (-self.decimals)
                                        if changed and change['oldvalue'] > 0 and change['value'] > 0:
                                            k = job.scale[1] * change['value']/change['oldvalue']
                                            #: copy: see width field
                                            oldvalue = job.scale[:]
                                            try:
                                                if job.lock_scale:
                                                    job.scale = [k, k]
                                                else:
                                                    job.scale[1] = k
                                            except Exception as e:
                                                plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                                job.scale = oldvalue
                                                self.value = change['oldvalue']
                                    suffix << " "+plugin.units
                                    minimum = 0.00001
                                    maximum = 99999.9
                        #CheckBox:
                        #    text = 'Scale to fit'
                        #    checked := job.auto_scale
                SectionHeader: h_copies:
                    name = 'section-graphic-copies'
                    title = QApplication.translate("job", "Graphic Copies")
                Section:
                    visible << h_copies.expanded
                    constraints = [
                        vbox(form,
                             hbox(pb1,pb2,cb1,spacer)),
                        align('v_center',pb1,pb2,cb1)
                    ]
                    padding = 0
                    Form: form:
                        padding = 0
                        ImageView:
                            image = load_image('shape_copy')
                        SpinBox:
                            value << job.copies
                            value ::
                                oldvalue = job.copies
                                try:
                                    job.copies = change['value']
                                except Exception as e:
                                   plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                   job.copies = oldvalue
                                   self.value = change['oldvalue']
                            minimum = 1
                            maximum = 99999
                            suffix << job.auto_copies and "   (minimum set to %s)"%job._desired_copies or ""
                    PushButton: pb1:
                        icon = load_icon('shape_square_add')
                        clicked ::
                            oldvalue = job.copies
                            try:
                                job.add_stack()
                            except Exception as e:
                               plugin.workbench.message_critical(title="Does not fit", message=str(e))
                               job.copies = oldvalue
                               self.value = change['oldvalue']
                    PushButton: pb2:
                        icon = load_icon('shape_square_delete')
                        clicked :: job.remove_stack()
                    CheckBox: cb1:
                        text = QApplication.translate("job", "Fill to save space")
                        checked := job.auto_copies

                Section:
                    visible << not job.items
                    padding = 0
                    SectionHeader: h_rotation:
                        name = 'section-graphic-rotation'
                        title = QApplication.translate("job", "Graphic Rotation")
                    Section:
                        visible << h_rotation.expanded
                        padding = 0
                        Form:
                            padding = 0
                            ImageView:
                                image = load_image('shape_rotate_clockwise')
                            DoubleSpinBox:
                                value << job.rotation
                                value ::
                                    oldvalue = job.rotation
                                    try:
                                        job.rotation = change['value']
                                    except Exception as e:
                                        plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                        job.rotation = oldvalue
                                        self.value = change['oldvalue']
                                suffix = " °"
                                maximum = 180
                                minimum = -180
                                wrapping = True
                                single_step = 15
                        Container:
                            #: Illustrator-style quick rotate; wraps into [-180, 180]
                            padding = 0
                            constraints = [hbox(rl, rr, r180, spacer)]
                            PushButton: rl:
                                text = '90° ' + QApplication.translate("job", "left")
                                icon = load_icon('shape_rotate_anticlockwise')
                                clicked ::
                                    oldvalue = job.rotation
                                    try:
                                        job.rotation = ((job.rotation + 90 + 180) % 360) - 180
                                    except Exception as e:
                                        plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                        job.rotation = oldvalue
                            PushButton: rr:
                                text = '90° ' + QApplication.translate("job", "right")
                                icon = load_icon('shape_rotate_clockwise')
                                clicked ::
                                    oldvalue = job.rotation
                                    try:
                                        job.rotation = ((job.rotation - 90 + 180) % 360) - 180
                                    except Exception as e:
                                        plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                        job.rotation = oldvalue
                            PushButton: r180:
                                text = '180°'
                                clicked ::
                                    oldvalue = job.rotation
                                    try:
                                        job.rotation = ((job.rotation + 180 + 180) % 360) - 180
                                    except Exception as e:
                                        plugin.workbench.message_critical(title="Does not fit", message=str(e))
                                        job.rotation = oldvalue
                        CheckBox:
                            text = QApplication.translate("job", "Rotate to save space")
                            checked := job.auto_rotate
                Section:
                    visible << not job.items
                    padding = 0

                    SectionHeader: h_mirror:
                        name = 'section-graphic-mirroring'
                        title = QApplication.translate("job", "Graphic Mirroring")
                    Section:
                        visible << h_mirror.expanded
                        padding = 0
                        Container:
                            padding = 0
                            constraints = [hbox(mx, my, spacer)]
                            PushButton: mx:
                                checkable = True
                                text = QApplication.translate("job", "Flip Vertical")
                                icon = load_icon('shape_flip_vertical')
                                tool_tip = QApplication.translate("job", "Mirror about x-axis")
                                checked := job.mirror[1]
                            PushButton: my:
                                checkable = True
                                text = QApplication.translate("job", "Flip Horizontal")
                                icon = load_icon('shape_flip_horizontal')
                                tool_tip = QApplication.translate("job", "Mirror about y-axis")
                                checked := job.mirror[0]


enamldef WeedlinesDockItem(DockItem):
    attr plugin
    attr job: Job << plugin.job
    title = QApplication.translate("job", "Weedlines")
    name = 'weedlines-item'
    icon = load_icon('shape_group')
    Container:
        padding = 0
        PanelScroll:
            Container:
                SectionHeader: h_spacing:
                    name = 'section-graphic-spacing'
                    title = QApplication.translate("job", "Graphic Spacing")
                Section:
                    visible << h_spacing.expanded
                    padding = 0
                    Form:
                        padding = 0
                        Label:
                            text = QApplication.translate("job", "Row")
                        DoubleSpinBox:
                            value << to_unit(job.copy_spacing[0], plugin.units)
                            value :: try_update_setting(plugin, self, job.copy_spacing, 0, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1
                        Label:
                            text = QApplication.translate("job", "Col")
                        DoubleSpinBox:
                            value << to_unit(job.copy_spacing[1], plugin.units)
                            value :: try_update_setting(plugin, self, job.copy_spacing, 1, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1

                SectionHeader: h_order:
                    name = 'section-plotting-order'
                    title = QApplication.translate("job", "Plotting Order")
                Section:
                    visible << h_order.expanded
                    padding = 0

                    Form:
                        padding = 0
                        ImageView:
                            image = load_image('chart_line')
                        ObjectCombo:
                            items = list(job.__class__.order.items)
                            to_string = lambda it: QApplication.translate("job", it)
                            selected := job.order
                            hug_width = 'ignore' # Expanding
                SectionHeader: h_plot_weedlines:
                    name = 'section-plot-weedlines'
                    title = QApplication.translate("job", "Plot Weedlines")
                Section:
                    visible << h_plot_weedlines.expanded
                    padding = 0

                    CheckBox:
                        text = QApplication.translate("job", "Add weedline to plot")
                        icon = load_icon('shape_group')
                        checked := job.plot_weedline
                    CheckBox:
                        text = QApplication.translate("job", "Add weedline to copies")
                        icon = load_icon('shape_ungroup')
                        checked := job.copy_weedline
                SectionHeader: h_weedline_padding:
                    name = 'section-weedline-padding'
                    title = QApplication.translate("job", "Weedline Padding")
                Section:
                    visible << h_weedline_padding.expanded
                    padding = 0

                    Form:
                        padding = 0
                        ImageView:
                            image = load_image('text_padding_left')
                        DoubleSpinBox:
                            value << to_unit(job.copy_weedline_padding[0], plugin.units)
                            value :: try_update_setting(plugin, self, job.copy_weedline_padding, 0, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1
                        ImageView:
                            image = load_image('text_padding_top')
                        DoubleSpinBox:
                            value << to_unit(job.copy_weedline_padding[1], plugin.units)
                            value :: try_update_setting(plugin, self, job.copy_weedline_padding, 1, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1
                        ImageView:
                            image = load_image('text_padding_right')
                        DoubleSpinBox:
                            value << to_unit(job.copy_weedline_padding[2], plugin.units)
                            value :: try_update_setting(plugin, self, job.copy_weedline_padding, 2, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1
                        ImageView:
                            image = load_image('text_padding_bottom')
                        DoubleSpinBox:
                            value << to_unit(job.copy_weedline_padding[3], plugin.units)
                            value :: try_update_setting(plugin, self, job.copy_weedline_padding, 3, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1


                Section:
                    visible << bool(job.items)
                    padding = 0
                    SectionHeader: h_file_weedlines:
                        name = 'section-file-weedlines'
                        title = QApplication.translate("job", "File Weedlines")
                    Section:
                        visible << h_file_weedlines.expanded
                        padding = 0
                        Label:
                            visible << bool(job.layout_problems)
                            text << job.layout_problem_text(job.layout_problems)
                        CheckBox:
                            text = QApplication.translate("job", "Allow rotating when arranging")
                            checked := job.item_allow_rotation
                        Form:
                            padding = 0
                            Label:
                                text = QApplication.translate("job", "Snap grid")
                            DoubleSpinBox:
                                value << to_unit(job.item_snap_grid, plugin.units)
                                value :: job.item_snap_grid = from_unit(change['value'], plugin.units)
                                suffix << " "+plugin.units
                                minimum = 0
                                maximum = 99999.9
                                single_step = 0.1
                        CheckBox:
                            text = QApplication.translate("job", "Weedline around each graphic")
                            checked << bool(job.items) and all([item.weedline for item in job.items])
                            toggled :: job.set_item_weedlines(self.checked)
                        Label:
                            text = QApplication.translate("job", "Graphic weedline padding")
                        Form:
                            padding = 0
                            ImageView:
                                image = load_image('text_padding_left')
                            DoubleSpinBox:
                                value << to_unit(job.item_weedline_padding[0], plugin.units)
                                value :: try_update_setting(plugin, self, job.item_weedline_padding, 0, change)
                                suffix << " "+plugin.units
                                maximum = 99999.9
                                single_step = 0.1
                            ImageView:
                                image = load_image('text_padding_top')
                            DoubleSpinBox:
                                value << to_unit(job.item_weedline_padding[1], plugin.units)
                                value :: try_update_setting(plugin, self, job.item_weedline_padding, 1, change)
                                suffix << " "+plugin.units
                                maximum = 99999.9
                                single_step = 0.1
                            ImageView:
                                image = load_image('text_padding_right')
                            DoubleSpinBox:
                                value << to_unit(job.item_weedline_padding[2], plugin.units)
                                value :: try_update_setting(plugin, self, job.item_weedline_padding, 2, change)
                                suffix << " "+plugin.units
                                maximum = 99999.9
                                single_step = 0.1
                            ImageView:
                                image = load_image('text_padding_bottom')
                            DoubleSpinBox:
                                value << to_unit(job.item_weedline_padding[3], plugin.units)
                                value :: try_update_setting(plugin, self, job.item_weedline_padding, 3, change)
                                suffix << " "+plugin.units
                                maximum = 99999.9
                                single_step = 0.1


enamldef LayersDockItem(DockItem):
    attr plugin
    attr job: Job << plugin.job
    attr filters << job.svg_filters if job else []

    title = QApplication.translate("job", "Layers")
    name = 'layers-item'
    icon = load_icon('layers')
    Container:
        padding = 0
        PanelScroll:
            Container:
                SectionHeader: h_layers:
                    name = 'section-layers'
                    title = QApplication.translate("job", "Layers")
                Section:
                    visible << h_layers.expanded
                    padding = 0
                    Looper:
                        iterable << [f for f in filters if f.type == 'layer']
                        CheckBox: cb:
                            attr layer = loop_item
                            text = layer.name
                            checked := layer.enabled
                            toggled :: job.update_document({'name': 'layer'})
                        #Conditional:
                            #condition << cb.checked
                            #Form:
                                #attr layer = loop_item
                                #padding = 0
                                #Label:
                                    #text= "X Offset"
                                #DoubleSpinBox:
                                    #value << to_unit(layer.offset_x, plugin.units)
                                    #value :: layer.offset_x = from_unit(value, plugin.units)
                                    #suffix << " "+plugin.units
                                    #minimum = -9999
                                    #maximum = 9999
                                    #single_step = 10
                                #Label:
                                    #text = "Y Offset"
                                #DoubleSpinBox:
                                    #value << to_unit(layer.offset_y, plugin.units)
                                    #value :: layer.offset_x = from_unit(value, plugin.units)
                                    #suffix << " "+plugin.units
                                    #minimum = -9999
                                    #maximum = 9999
                                    #single_step = 10
                SectionHeader: h_fill:
                    name = 'section-fill-colors'
                    title = QApplication.translate("job", "Fill Colors")
                Section:
                    visible << h_fill.expanded
                    padding = 0
                    Form:
                        padding = 0
                        Looper:
                            iterable << [f for f in filters if f.type == 'fill-color']
                            CheckBox:
                                attr color_filter = loop_item
                                text = color_filter.name
                                icon << color_icon(color_filter.color)
                                checked := color_filter.enabled
                                toggled :: job.update_document({'name': 'color'})

                SectionHeader: h_stroke:
                    name = 'section-stroke-colors'
                    title = QApplication.translate("job", "Stroke Colors")
                Section:
                    visible << h_stroke.expanded
                    padding = 0
                    Form:
                        padding = 0
                        Looper:
                            iterable << [f for f in filters if f.type == 'stroke-color']
                            CheckBox:
                                attr color_filter = loop_item
                                text = color_filter.name
                                icon << color_icon(color_filter.color)
                                checked := color_filter.enabled
                                toggled :: job.update_document({'name': 'color'})


enamldef MaterialDockItem(DockItem):
    attr plugin
    attr job: Job << plugin.job
    title = QApplication.translate("job", "Material")
    name = "material-item"
    icon = load_icon('note')
    Container:
        padding = 0
        PanelScroll:
            Container:
                SectionHeader: h_area:
                    name = 'section-plot-area'
                    title = QApplication.translate("job", "Plot Area")
                Section:
                    visible << h_area.expanded
                    padding = 0

                    Form:
                        padding = 0
                        ImageView:
                            image = load_image('shape_square_width')
                        DoubleSpinBox:
                            value << to_unit(job.material.size[0], plugin.units)
                            value :: try_update_setting(plugin, self, job.material.size, 0, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            #maximum << to_unit(job.material.size[0], plugin.units)
                            #single_step = 0.1
                        ImageView:
                            image = load_image('shape_square_height')
                        DoubleSpinBox:
                            value << to_unit(job.material.size[1], plugin.units)
                            value :: try_update_setting(plugin, self, job.material.size, 1, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            #maximum << to_unit(job.material.size[1], plugin.units)
                            #single_step = 0.1
#                Label:
#                    text = ""
#                PushButton:
#                    text = "Read from device"
#                    tool_tip = "Get the material size by querying the device."
#                    clicked ::
#                        try:
#                            job.material.size = plugin.device.querySize()
#                        except NotImplementedError:
#                            pass

                SectionHeader: h_margins:
                    name = 'section-plot-margins'
                    title = QApplication.translate("job", "Plot Margins")
                Section:
                    visible << h_margins.expanded
                    padding = 0

                    Form:
                        padding = 0
                        ImageView:
                            image = load_image('text_padding_left')
                        DoubleSpinBox:
                            value << to_unit(job.material.padding[0], plugin.units)
                            value :: try_update_setting(plugin, self, job.material.padding, 0, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1
                        ImageView:
                            image = load_image('text_padding_top')
                        DoubleSpinBox:
                            value << to_unit(job.material.padding[1], plugin.units)
                            value :: try_update_setting(plugin, self, job.material.padding, 1, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1
                        ImageView:
                            image = load_image('text_padding_right')
                        DoubleSpinBox:
                            value << to_unit(job.material.padding[2], plugin.units)
                            value :: try_update_setting(plugin, self, job.material.padding, 2, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1
                        ImageView:
                            image = load_image('text_padding_bottom')
                        DoubleSpinBox:
                            value << to_unit(job.material.padding[3], plugin.units)
                            value :: try_update_setting(plugin, self, job.material.padding, 3, change)
                            suffix << " "+plugin.units
                            maximum = 99999.9
                            single_step = 0.1
                SectionHeader: h_alignment:
                    name = 'section-plot-alignment'
                    title = QApplication.translate("job", "Plot Alignment")
                Section:
                    visible << h_alignment.expanded
                    padding = 0

                    CheckBox:
                        visible << not job.items
                        text = QApplication.translate("job", 'Shift to origin')
                        icon = load_icon('shape_align_left')
                        checked := job.auto_shift
                    CheckBox:
                        visible << not job.items
                        text = QApplication.translate("job", 'Align center horizontally')
                        icon = load_icon('shape_align_center')
                        checked := job.align_center[0]
                    CheckBox:
                        visible << not job.items
                        text = QApplication.translate("job", 'Align center vertically')
                        icon = load_icon('shape_align_middle')
                        checked := job.align_center[1]
                    CheckBox:
                        text = QApplication.translate("device", "Clip to plot area")
                        icon = load_icon('shape_square_width')
                        checked := job.clip_to_plot_area

                SectionHeader: h_feeding:
                    name = 'section-plot-feeding'
                    title = QApplication.translate("job", "Plot Feeding")
                Section:
                    visible << h_feeding.expanded
                    padding = 0
                    constraints = [
                        vbox(rb1,
                             hbox(rb2,dsb)),
                        align('v_center',rb2,dsb)
                    ]
                    RadioButton: rb1:
                        text = QApplication.translate("job", "Return to origin")
                        checked << not job.feed_to_end
                    RadioButton: rb2:
                        text = QApplication.translate("job", "Feed after")
                        checked := job.feed_to_end
                    DoubleSpinBox: dsb:
                        value << to_unit(job.feed_after, plugin.units)
                        value :: job.feed_after = from_unit(change['value'],plugin.units)
                        suffix << " "+plugin.units
                        maximum = 99999.9
                        single_step = 0.1


enamldef JobHistoryDockItem(DockItem):
    attr plugin
    title = QApplication.translate("job", "Jobs")
    name = 'job-history-item'
    icon = load_icon('application_view_list')
    Container:
        padding = 0
        TableView: table:
            horizontal_headers = ['Date', 'Document', 'Count', 'Duration', 'Status', 'Copies', 'Rotation', 'Size', 'Material' ]
            horizontal_stretch = True
            resize_mode = 'resize_to_contents'
            items << plugin.jobs
            Looper:
                iterable << reversed(sorted(plugin.jobs, key=lambda j: j.info.created or datetime(1970, 1, 1)))
                TableViewRow:
                    attr job << loop_item
                    TableViewItem:
                        text << str(job.info.created.strftime('%c')) if job and job.info.created else ""
                    TableViewItem:
                        text << str(job) if job else ""
                        tool_tip = str(job) if job else ""
                    TableViewItem:
                        text << str(job.info.count) if job else "0"
                    TableViewItem:
                         attr duration << job.info.duration.total_seconds() if job and job.info.duration else 0
                         text << "{} min {} sec".format(
                                int(duration/60),
                                int(duration%60)
                                ) if (duration) else ""
                    TableViewItem:
                        text << str(job.info.status) if job else ""
                    TableViewItem:
                        text << str(job.copies) if job else ""
                    TableViewItem:
                        text << "{} °".format(job.rotation) if job else ""
                    TableViewItem:
                        text << "{} {} x {} {}".format(
                                round(to_unit(job.size[0], plugin.units), 2), plugin.units,
                                round(to_unit(job.size[1], plugin.units), 2), plugin.units,
                            ) if job and job.model else ""
                    TableViewItem:
                        text << "{} {} x {} {}".format(
                                round(to_unit(job.material.size[0], plugin.units), 2), plugin.units,
                                round(to_unit(job.material.size[1], plugin.units), 2), plugin.units,
                            ) if job and job.model else ""
                    Menu:
                        Action:
                            text = QApplication.translate("job", "Open job")
                            icon = load_icon("control_equalizer_blue")
                            triggered :: plugin.job = job
                        Action:
                            separator = True
                        Action:
                            text = QApplication.translate("job", "Send job to device")
                            icon = load_icon("control_repeat_blue")
                            triggered ::
                                core = plugin.workbench.get_plugin("enaml.workbench.core")
                                core.invoke_command('inkcut.device.submit', parameters={'job': job})
                        Action:
                            separator = True
                        Action:
                            text = QApplication.translate("job", "Remove from list")
                            icon = load_icon("bin")
                            triggered ::
                                if job in plugin.jobs:
                                    jobs = plugin.jobs[:]
                                    jobs.remove(job)
                                    plugin.jobs = jobs


