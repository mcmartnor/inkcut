import enaml
from enaml.core.include import Include
from enaml.layout.api import AreaLayout, TabLayout, DockBarLayout, HSplitLayout
from enaml.stdlib.dock_area_styles import (
    register_styles, available_styles, CommonStyles, AreaStyle, ItemStyle,
    TitleBarStyle
)
from enaml.qt import QT_API
from inkcut.core.api import DockArea, DockItem
from inkcut.core.theme import Theme, effective_dock_style


IS_QT4 = QT_API in ('pyside', 'pyside2')


def get_system_color(name='window'):
    from enaml.qt.QtWidgets import QWidget
    palette = QWidget().palette()
    qcolor = getattr(palette, name)().color()
    if IS_QT4:
        return qcolor.name()
    else:
        return qcolor.name(qcolor.HexArgb)

def available_languages():
    return ["English", "Francais"]

template SystemStyle():
    """ DockArea style sheet styles that uses the system colors

    """
    CommonStyles():
        pass
    AreaStyle:
        background = get_system_color('window')
    ItemStyle:
        background = get_system_color('window')
        border = '1px solid '+get_system_color('base')
    TitleBarStyle:
        background = get_system_color('base')


if 'system' not in available_styles():
    register_styles('system', SystemStyle)


enamldef DockView(DockArea): area:
    attr workbench
    attr plugin
    attr theme = Theme.instance()
    #: Palette darkness the current style sheet was made for
    attr theme_dark = False
    style << plugin.effective_dock_style
    layout << plugin.dock_layout

    func restyle_on_palette(change):
        # The system style reads the palette when it is created, so
        # create it again when the palette changes and it stays in use.
        was = effective_dock_style(plugin.dock_style, theme_dark)
        area.theme_dark = theme.dark
        if style == 'system' and was == 'system':
            area.style = ''
            area.style = 'system'

    func unhook_theme(change):
        theme.unobserve('revision', restyle_on_palette)

    initialized ::
        if theme is not None:
            area.theme_dark = theme.dark
            theme.observe('revision', restyle_on_palette)
            area.observe('destroyed', unhook_theme)

    Include:
        objects << plugin.dock_items
