Shared panel widgets: a scroll area for the dock panels, the header of
a collapsible section and the dark input field styles.
"""
from enaml.styling import StyleSheet, Style, Setter
from enaml.widgets.api import Container, ScrollArea, ToolButton
from enaml.qt.QtWidgets import QWidget
from inkcut.core.theme import PANEL_COLORS


enamldef PanelScroll(ScrollArea):
    """ Scrolls a panel's content when it is taller than the dock item.

    The viewport, the scrolled content (QScrollArea.setWidget turns its
    autoFillBackground on) and the corner between the scroll bars are not
    filled, so the dock item background (the dock style) shows through.

    """
    border = None
    resist_height = 'ignore'
    #: The minimum width is set from the content in follow_content_width,
    #: not from the hint, so long file names do not widen the dock
    resist_width = 'ignore'
    minimum_size = (0, 120)
    horizontal_policy = 'as_needed'
    vertical_policy = 'as_needed'
    activated ::
        widget = self.proxy.widget
        widget.viewport().setAutoFillBackground(False)
        if widget.widget() is not None:
            widget.widget().setAutoFillBackground(False)
        corner = QWidget()
        corner.setAutoFillBackground(False)
        widget.setCornerWidget(corner)
        widget.layoutRequested.connect(self.follow_content_width)
        self.follow_content_width()
    func follow_content_width():
        """ Minimum width = the content's minimum + the vertical bar, so
        the panel never needs horizontal scrolling for its own fields """
        if not self.proxy_is_active:
            return
        widget = self.proxy.widget
        inner = widget.widget()
        if inner is None:
            return
        w = (inner.minimumSizeHint().width()
             + widget.verticalScrollBar().sizeHint().width()
             + 2 * widget.frameWidth())
        if w != self.minimum_size[0]:
            self.minimum_size = (w, self.minimum_size[1])
            if isinstance(self.parent, Container):
                self.parent.request_relayout()


enamldef SectionHeader(ToolButton):
    """ The header of a collapsible panel section: shows or hides the
    Section below it (bind its visible to the header's expanded).

    """
    attr title = ''
    attr expanded: bool = True
    auto_raise = True
    checkable = True
    checked := expanded
    button_style = 'text_only'
    hug_width = 'ignore'
    style_class = 'section-header'
    #: '&' is shown, not taken as a mnemonic
    text << ('▾ ' if expanded else '▸ ') + title.replace('&', '&&')
    activated :: self.proxy.widget.setAccessibleName(title)
    title ::
        if self.proxy_is_active:
            self.proxy.widget.setAccessibleName(title)


enamldef DarkWidgetStyles(StyleSheet):
    """ Dark input fields and section headers. The ui plugin sets it as
    the application style sheet while the palette is dark.

    """
    Style:
        element = 'Field, SpinBox'
        Setter:
            field = 'background'
            value = PANEL_COLORS['field']
        Setter:
            field = 'border'
            value = '1px solid ' + PANEL_COLORS['border']
        Setter:
            field = 'color'
            value = PANEL_COLORS['text']
    Style:
        element = 'ObjectCombo'
        Setter:
            field = 'background'
            value = PANEL_COLORS['field']
        Setter:
            field = 'border'
            value = '1px solid ' + PANEL_COLORS['border']
        Setter:
            field = 'color'
            value = PANEL_COLORS['text']
    Style:
        style_class = 'section-header'
        Setter:
            field = 'background'
            value = PANEL_COLORS['title']
        Setter:
            field = 'color'
            value = PANEL_COLORS['text']
